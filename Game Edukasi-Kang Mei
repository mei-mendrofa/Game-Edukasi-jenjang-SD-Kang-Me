            sfxClick();
            fontScale = Math.max(-1, Math.min(2, fontScale + delta));
            const storyEl = document.getElementById('story-text');
            const sizes = ['text-base', 'text-lg sm:text-xl', 'text-xl sm:text-2xl', 'text-2xl sm:text-3xl'];
            storyEl.className = `${sizes[fontScale + 1]} leading-relaxed text-amber-950 font-medium text-justify transition-all`;
        }

        // ==================== RENDER GAMEPLAY ====================
        function initGame() {
            renderMission();
            renderTeacherGuide();
            updateMapUI();
            updateHUD();
        }

        function renderMission() {
            stopSpeech();
            userOrbitAngleX = 0;
            userOrbitAngleY = 0;
            const m = missions[currentPos];

            document.getElementById('stage-pos-badge').innerText = `POS ${m.pos} / 4`;
            document.getElementById('stage-location-title').innerText = m.stageTitle;
            document.getElementById('speaker-name').innerText = m.speaker;
            document.getElementById('pos-badge').innerText = `POS MISI ${m.pos} DARI 4`;
            document.getElementById('pos-title').innerText = m.title;
            document.getElementById('pos-skill').innerText = m.skill;
            document.getElementById('location-tag').innerText = m.location;
            document.getElementById('scene-avatar').innerText = m.avatar;
            document.getElementById('pos-character-quote').innerText = `"${m.quote}"`;
            document.getElementById('story-text').innerHTML = m.narrative;
            document.getElementById('question-text').innerText = m.question;

            const preHint = document.getElementById('pre-hint-box');
            preHint.classList.add('hidden');
            preHint.innerHTML = `<strong>💡 Petunjuk Membaca:</strong> ${m.hint}`;
            document.getElementById('feedback-box').classList.add('hidden');

            const optContainer = document.getElementById('options-container');
            optContainer.innerHTML = '';

            const badgeColors = {
                'A': 'bg-rose-600 text-white border-rose-950',
                'B': 'bg-sky-600 text-white border-sky-950',
                'C': 'bg-amber-400 text-amber-950 border-amber-950',
                'D': 'bg-emerald-600 text-white border-emerald-950'
            };

            m.options.forEach(opt => {
                const btn = document.createElement('button');
                btn.id = `opt-${opt.label}`;
                btn.onclick = () => checkAnswer(opt.label);
                btn.className = `opt-btn text-left p-4 sm:p-5 rounded-2xl bg-white hover:bg-amber-100/90 border-4 border-amber-900 flex items-start gap-4 btn-3d transition group`;
                btn.innerHTML = `
                    <span class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl ${badgeColors[opt.label]} border-2 font-game font-bold text-lg sm:text-xl flex items-center justify-center shrink-0 shadow group-hover:scale-105 transition">
                        ${opt.label}
                    </span>
                    <span class="text-sm sm:text-base font-bold text-amber-950 leading-snug pt-0.5">
                        ${opt.text}
                    </span>
                `;
                optContainer.appendChild(btn);
            });

            updateMapUI();
        }

        function showPreHint() {
            sfxClick();
            document.getElementById('pre-hint-box').classList.toggle('hidden');
        }

        function checkAnswer(selectedLabel) {
            const m = missions[currentPos];
            const fbBox = document.getElementById('feedback-box');
            const fbIcon = document.getElementById('feedback-icon');
            const fbTitle = document.getElementById('feedback-title');
            const fbExp = document.getElementById('feedback-explanation');
            const rewardBadge = document.getElementById('artifact-reward-badge');
            const nextBtn = document.getElementById('next-btn');
            const retryBtn = document.getElementById('retry-btn');

            document.querySelectorAll('.opt-btn').forEach(b => {
                b.disabled = true;
                b.classList.add('opacity-60', 'cursor-not-allowed');
            });

            const chosenBtn = document.getElementById(`opt-${selectedLabel}`);
            chosenBtn.classList.remove('opacity-60');

            fbBox.classList.remove('hidden', 'bg-emerald-100', 'border-emerald-800', 'bg-rose-100', 'border-rose-800');

            if (selectedLabel === m.correct) {
                sfxSuccess();
                jumpCelebrationTimer = 95; // Make 3D Pixar characters jump with joy!
                chosenBtn.classList.replace('bg-white', 'bg-emerald-200');
                chosenBtn.classList.replace('border-amber-900', 'border-emerald-800');

                fbBox.classList.add('bg-emerald-100', 'border-emerald-800');
                fbIcon.innerText = '🎉';
                fbTitle.innerText = `Luar Biasa! Jawaban (${selectedLabel}) Tepat!`;
                fbTitle.className = 'font-game text-xl sm:text-2xl font-bold text-emerald-950';
                fbExp.innerHTML = `<span class="text-emerald-950"><strong>3. Kunci Jawaban & Pembahasan Singkat:</strong> ${m.explanation}</span>`;

                if (!completedPos[currentPos]) {
                    score += 100;
                    completedPos[currentPos] = true;
                    rewardBadge.innerText = `+100 XP & Bukti "${m.artifactName}" Ditemukan!`;
                    rewardBadge.classList.remove('hidden');
                    updateHUD();
                } else {
                    rewardBadge.classList.add('hidden');
                }

                retryBtn.classList.add('hidden');
                nextBtn.classList.remove('hidden');
                nextBtn.innerHTML = currentPos < 3
                    ? `<span>Terbang ke Pos Misi ${currentPos + 2}</span> <span>➔</span>`
                    : `<span>Kembalikan Mahkota ke Singgasana 3D!</span> <span>👑</span>`;
            } else {
                sfxWrong();
                chosenBtn.classList.replace('bg-white', 'bg-rose-200');
                chosenBtn.classList.replace('border-amber-900', 'border-rose-800');

                fbBox.classList.add('bg-rose-100', 'border-rose-800');
                fbIcon.innerText = '🧐';
                fbTitle.innerText = `Hmm, Jawaban (${selectedLabel}) Belum Tepat!`;
                fbTitle.className = 'font-game text-xl sm:text-2xl font-bold text-rose-950';
                fbExp.innerHTML = `<span class="text-rose-950"><strong>Petunjuk Detektif (Clue):</strong> ${m.hint}</span>`;
                rewardBadge.classList.add('hidden');

                if (lives > 1) lives--;
                updateHUD();

                nextBtn.classList.add('hidden');
                retryBtn.classList.remove('hidden');
            }

            updateMapUI();
            fbBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function retryQuestion() {
            sfxClick();
            document.getElementById('feedback-box').classList.add('hidden');
            document.querySelectorAll('.opt-btn').forEach(b => {
                b.disabled = false;
                b.classList.remove('opacity-60', 'cursor-not-allowed', 'bg-rose-200', 'border-rose-800');
                b.classList.add('bg-white', 'border-amber-900');
            });
        }

        function nextMission() {
            sfxClick();
            stopTimer();
            if (currentPos < 3) {
                currentPos++;
                renderMission();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else {
                sfxVictory();
                jumpCelebrationTimer = 180;
                launchConfetti();
                document.getElementById('mission-card').classList.add('hidden');
                const vic = document.getElementById('victory-screen');
                vic.classList.remove('hidden');
                document.getElementById('final-score').innerText = `${score} XP`;
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        function jumpToPos(index) {
            sfxClick();
            document.getElementById('victory-screen').classList.add('hidden');
            document.getElementById('mission-card').classList.remove('hidden');
            currentPos = index;
            renderMission();
        }

        function updateHUD() {
            document.getElementById('score-display').innerText = score;
            document.getElementById('lives-display').innerText = '❤️'.repeat(lives) + '🖤'.repeat(3 - lives);

            let count = 0;
            for (let i = 0; i < 4; i++) {
                const slot = document.getElementById(`artifact-${i}`);
                if (completedPos[i]) {
                    count++;
                    slot.classList.remove('opacity-40', 'border-amber-700/60');
                    slot.classList.add('opacity-100', 'border-amber-400', 'bg-amber-800/90', 'scale-105', 'shadow-lg');
                } else {
                    slot.classList.add('opacity-40', 'border-amber-700/60');
                    slot.classList.remove('opacity-100', 'border-amber-400', 'bg-amber-800/90', 'scale-105', 'shadow-lg');
                }
            }
            document.getElementById('clue-counter').innerText = `${count}/4 Bukti`;
        }

        function updateMapUI() {
            const perc = (currentPos / 3) * 82;
            document.getElementById('progress-bar').style.width = `${perc}%`;

            for (let i = 0; i < 4; i++) {
                const node = document.getElementById(`node-${i}`);
                const box = node.querySelector('.node-box');
                const label = node.querySelector('.node-label');
                const camBtn = document.getElementById(`cam-pos-${i}`);

                box.classList.remove('pos-active-glow');

                if (i === currentPos) {
                    box.className = 'node-box w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-br from-amber-300 to-amber-500 border-4 border-amber-950 flex items-center justify-center text-xl sm:text-2xl shadow-xl pos-active-glow scale-110 transition-all';
                    label.className = 'node-label mt-1 text-xs font-game font-bold bg-amber-950 text-amber-200 px-2 py-0.5 rounded-lg shadow';
                    if (camBtn) camBtn.className = 'px-2.5 py-1 rounded-xl font-game font-bold text-xs bg-amber-400 text-amber-950 shadow transition';
                } else if (completedPos[i]) {
                    box.className = 'node-box w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-br from-emerald-400 to-emerald-600 border-4 border-emerald-950 flex items-center justify-center text-xl sm:text-2xl shadow-md transition-all';
                    label.className = 'node-label mt-1 text-xs font-game font-bold bg-emerald-900 text-emerald-100 px-2 py-0.5 rounded-lg shadow';
                    if (camBtn) camBtn.className = 'px-2.5 py-1 rounded-xl font-game font-bold text-xs bg-emerald-600 text-white transition';
                } else {
                    box.className = 'node-box w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-amber-100 border-4 border-amber-800/60 flex items-center justify-center text-xl sm:text-2xl shadow opacity-75 hover:opacity-100 transition-all';
                    label.className = 'node-label mt-1 text-xs font-game font-bold bg-amber-800/70 text-amber-100 px-2 py-0.5 rounded-lg';
                    if (camBtn) camBtn.className = 'px-2.5 py-1 rounded-xl font-game font-bold text-xs text-amber-200 hover:bg-white/10 transition';
                }
            }
        }

        // ==================== SKOR KELOMPOK & TIMER ====================
        function addTeamScore(teamIdx) {
            sfxClick();
            teamScores[teamIdx] += 100;
            document.getElementById(`team-score-${teamIdx}`).innerText = teamScores[teamIdx];
        }

        function resetTeams() {
            sfxClick();
            teamScores = [0, 0, 0, 0];
            for (let i = 0; i < 4; i++) {
                document.getElementById(`team-score-${i}`).innerText = 0;
            }
        }

        function resetGame() {
            sfxClick();
            currentPos = 0;
            score = 0;
            lives = 3;
            completedPos = [false, false, false, false];
            updateHUD();
            document.getElementById('victory-screen').classList.add('hidden');
            document.getElementById('mission-card').classList.remove('hidden');
            renderMission();
        }

        function toggleTimer() {
            sfxClick();
            if (timerInterval) {
                stopTimer();
            } else {
                timeLeft = 120;
                updateTimerText();
                timerInterval = setInterval(() => {
                    timeLeft--;
                    updateTimerText();
                    if (timeLeft <= 0) {
                        stopTimer();
                        sfxVictory();
                        document.getElementById('timer-display').innerText = "⏰ Waktu Diskusi Habis!";
                    }
                }, 1000);
            }
        }

        function stopTimer() {
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
            }
            document.getElementById('timer-display').innerText = "Timer Diskusi (02:00)";
        }

        function updateTimerText() {
            const m = String(Math.floor(timeLeft / 60)).padStart(2, '0');
            const s = String(timeLeft % 60).padStart(2, '0');
            document.getElementById('timer-display').innerText = `Sisa Diskusi: ${m}:${s} (Reset)`;
        }

        function toggleMode() {
            sfxClick();
            stopSpeech();
            isTeacherMode = !isTeacherMode;
            const gameView = document.getElementById('game-view');
            const teacherView = document.getElementById('teacher-view');
            const btnText = document.getElementById('mode-btn-text');
            const btnIcon = document.getElementById('mode-icon');

            if (isTeacherMode) {
                gameView.classList.add('hidden');
                teacherView.classList.remove('hidden');
                btnIcon.innerText = "🎮";
                btnText.innerText = "Layar Game 3D";
            } else {
                teacherView.classList.add('hidden');
                gameView.classList.remove('hidden');
                btnIcon.innerText = "📋";
                btnText.innerText = "Panduan & Kunci Guru";
                setTimeout(onResize3D, 50);
            }
        }

        function renderTeacherGuide() {
            const container = document.getElementById('teacher-content-list');
            container.innerHTML = missions.map(m => `
                <div class="bg-[#fffdf7] border-2 border-amber-500 rounded-3xl p-6 shadow-sm">
                    <div class="flex flex-wrap justify-between items-center gap-2 border-b-2 border-amber-200 pb-3 mb-4">
                        <div class="flex items-center gap-3">
                            <span class="text-3xl">${m.avatar}</span>
                            <div>
                                <h3 class="text-xl font-bold text-amber-950">
                                    Pos Misi ${m.pos}: ${m.title}
                                </h3>
                                <span class="text-xs font-bold text-amber-700">${m.location}</span>
                            </div>
                        </div>
                        <span class="text-xs font-extrabold bg-amber-200 text-amber-950 px-3 py-1 rounded-full border border-amber-500">
                            ${m.skill}
                        </span>
                    </div>

                    <div class="mb-4">
                        <div class="text-xs font-extrabold uppercase text-amber-800 mb-1.5">1. Narasi Cerita (1 Paragraf Penuh):</div>
                        <p class="text-sm sm:text-base text-amber-950 bg-amber-50/70 p-4 rounded-2xl border border-amber-300 leading-relaxed text-justify">
                            ${m.narrative}
                        </p>
                    </div>

                    <div class="mb-4">
                        <div class="text-xs font-extrabold uppercase text-amber-800 mb-1.5">2. Tantangan Misi (Pilihan Ganda A, B, C, D):</div>
                        <p class="font-bold text-amber-950 mb-2.5">${m.question}</p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm sm:text-base">
                            ${m.options.map(o => `
                                <div class="${o.label === m.correct ? 'font-bold text-emerald-950 bg-emerald-100 px-3.5 py-2 rounded-xl border-2 border-emerald-600' : 'text-amber-900 bg-white px-3.5 py-2 rounded-xl border border-amber-200'}">
                                    <strong>${o.label}.</strong> ${o.text} ${o.label === m.correct ? '✅ (Kunci)' : ''}
                                </div>
                            `).join('')}
                        </div>
                    </div>

                    <div class="bg-amber-100/80 border-2 border-amber-400 rounded-2xl p-4 text-sm sm:text-base">
                        <span class="font-extrabold text-amber-950">3. Kunci Jawaban & Pembahasan Singkat (Jawaban: ${m.correct}):</span>
                        <p class="text-amber-950 mt-1 leading-relaxed">${m.explanation}</p>
                    </div>
                </div>
            `).join('');
        }

        // ==================== CONFETTI VICTORY EFFECT ====================
        function launchConfetti() {
            const canvas = document.getElementById('confetti-canvas');
            const ctx = canvas.getContext('2d');
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            const pieces = Array.from({ length: 90 }, () => ({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height - canvas.height,
                w: Math.random() * 10 + 6,
                h: Math.random() * 6 + 4,
                color: ['#fbbf24', '#10b981', '#f43f5e', '#38bdf8', '#a855f7'][Math.floor(Math.random() * 5)],
                vy: Math.random() * 3 + 2,
                vx: Math.random() * 2 - 1,
                angle: Math.random() * 360
            }));

            let frames = 0;
            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                pieces.forEach(p => {
                    p.y += p.vy;
                    p.x += p.vx;
                    p.angle += 4;
                    ctx.save();
                    ctx.translate(p.x, p.y);
                    ctx.rotate((p.angle * Math.PI) / 180);
                    ctx.fillStyle = p.color;
                    ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
                    ctx.restore();
                });
                frames++;
                if (frames < 180) requestAnimationFrame(draw);
                else ctx.clearRect(0, 0, canvas.width, canvas.height);
            }
            draw();
        }

        // Start 3D Pixar World & Game on Window Load
        window.onload = function () {
            initPixar3DWorld();
            initGame();
            animatePixar3D();
        };
    </script>
</body>
