        let clock = new THREE.Clock();
        function animatePixar3D() {
            requestAnimationFrame(animatePixar3D);
            const t = clock.getElapsedTime();

            // Smooth Camera Fly-To current Pos + User Orbit Offset
            const target = posCameraTargets[currentPos];
            const desiredCam = target.camPos.clone();
            desiredCam.x += Math.sin(userOrbitAngleX) * 6;
            desiredCam.y += userOrbitAngleY * 5;
            desiredCam.z += userZoomOffset;

            currentCamPos.lerp(desiredCam, 0.06);
            currentLookAt.lerp(target.lookAt, 0.07);
            camera.position.copy(currentCamPos);
            camera.lookAt(currentLookAt);

            // Animate Upgraded Hero Pixar Characters (Breathing, Eyebrows, Props, Cape & Heroic Jumps)
            characters3D.forEach((c, idx) => {
                const bounce = Math.abs(Math.sin(t * 2.8 + c.phase)) * 0.09;
                let celebrateJump = 0;
                if (jumpCelebrationTimer > 0) {
                    celebrateJump = Math.abs(Math.sin(t * 13 + idx)) * 0.72;
                }
                c.group.position.y = c.baseY + bounce + celebrateJump;

                // Spin 360 when clicked or triggered
                if (c.spinTimer > 0) {
                    c.spinTimer--;
                    c.group.rotation.y = c.baseRotY + ((45 - c.spinTimer) / 45) * Math.PI * 2;
                } else {
                    c.group.rotation.y = c.baseRotY + Math.sin(t * 0.9 + c.phase) * 0.1;
                }

                // Head & Expressive Eyebrows animation
                c.headGroup.rotation.z = Math.sin(t * 1.8 + c.phase) * 0.065;
                c.headGroup.rotation.y = Math.cos(t * 1.3 + c.phase) * 0.14;
                if (c.browsGroup) {
                    c.browsGroup.position.y = Math.sin(t * 3.2 + c.phase) * 0.025 + (jumpCelebrationTimer > 0 ? 0.05 : 0);
                }

                // Articulated Arms & Signature 3D Prop Waving
                c.leftArmGroup.rotation.z = Math.sin(t * 2.5 + c.phase) * 0.15;
                c.rightArmGroup.rotation.x = Math.cos(t * 2.8 + c.phase) * 0.22 - (jumpCelebrationTimer > 0 ? 0.6 : 0);
                if (c.propGroup) {
                    c.propGroup.rotation.y = Math.sin(t * 3.5 + c.phase) * 0.35;
                }

                // Subtle Foot Tapping & Jumping Legs
                c.leftLegGroup.rotation.x = Math.sin(t * 2.8 + c.phase) * 0.12;
                c.rightLegGroup.rotation.x = -Math.sin(t * 2.8 + c.phase) * 0.12;

                // Flowing Royal Cape & Pulsing Ground Aura Ring
                if (c.capeMesh) {
                    c.capeMesh.rotation.x = 0.18 + Math.sin(t * 4.2 + c.phase) * 0.12;
                }
                if (c.auraRing) {
                    const s = 1.0 + Math.sin(t * 3 + c.phase) * 0.08;
                    c.auraRing.scale.set(s, s, 1);
                }

                // Periodic Pixar Eye Blink
                const blinkCycle = (t + idx * 0.7) % 4.0;
                c.eyesGroup.scale.y = (blinkCycle > 3.85) ? 0.08 : 1.0;
            });

            if (jumpCelebrationTimer > 0) jumpCelebrationTimer--;

            // Rotate & Float the Golden Majapahit Crown
            if (floatingCrown3D) {
                floatingCrown3D.rotation.y = t * 1.2;
                floatingCrown3D.position.y = 2.65 + Math.sin(t * 2.5) * 0.25;
            }

            // Wave the Purple Silk Cloth Clue at Pos 1
            if (purpleCloth3D) {
                purpleCloth3D.rotation.z = 0.25 + Math.sin(t * 3.5) * 0.15;
            }

            // Drift Clouds
            clouds3D.forEach((cloud, i) => {
                cloud.position.x += 0.012 * ((i % 2) + 1);
                if (cloud.position.x > 30) cloud.position.x = -30;
            });

            // Float Golden Sparkles
            if (sparkles3D) {
                sparkles3D.rotation.y = t * 0.05;
            }

            renderer.render(scene, camera);
        }

        // ==================== WEB AUDIO SYNTHESIZER ====================
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        let audioCtx = null;

        function playTone(freq, type = 'sine', duration = 0.15, delay = 0) {
            if (!soundEnabled) return;
            try {
                if (!audioCtx) audioCtx = new AudioCtx();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime + delay);
                gain.gain.setValueAtTime(0.12, audioCtx.currentTime + delay);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + delay + duration);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start(audioCtx.currentTime + delay);
                osc.stop(audioCtx.currentTime + delay + duration);
            } catch (e) {}
        }

        function sfxClick() { playTone(520, 'triangle', 0.08); }
        function sfxSuccess() {
            playTone(523.25, 'sine', 0.12, 0);
            playTone(659.25, 'sine', 0.12, 0.1);
            playTone(783.99, 'sine', 0.15, 0.2);
            playTone(1046.50, 'triangle', 0.3, 0.3);
        }
        function sfxWrong() {
            playTone(240, 'sawtooth', 0.18, 0);
            playTone(180, 'sawtooth', 0.25, 0.15);
        }
        function sfxVictory() {
            [523.25, 659.25, 783.99, 1046.50, 783.99, 1046.50].forEach((f, idx) => {
                playTone(f, 'triangle', 0.18, idx * 0.12);
            });
        }

