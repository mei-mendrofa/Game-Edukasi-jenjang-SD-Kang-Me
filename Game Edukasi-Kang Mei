                emissive: emissiveHex
            });
        }

        function buildPixarEnvironment() {
            // Stylized Lush Green Island Base
            const groundGeo = new THREE.CylinderGeometry(42, 40, 3, 48);
            const groundMesh = new THREE.Mesh(groundGeo, pixarMat(0x65a30d, 0.65));
            groundMesh.position.set(0, -1.5, 0);
            groundMesh.receiveShadow = true;
            scene.add(groundMesh);

            // Terracotta Royal Path connecting Pos 1 to Pos 4
            const roadGeo = new THREE.BoxGeometry(44, 0.22, 5.2);
            const roadMesh = new THREE.Mesh(roadGeo, pixarMat(0xd97706, 0.55));
            roadMesh.position.set(0, 0.1, 2.2);
            roadMesh.receiveShadow = true;
            scene.add(roadMesh);

            // Decorative Stepping Stones
            for (let x = -20; x <= 20; x += 2.2) {
                const stone = new THREE.Mesh(
                    new THREE.CylinderGeometry(0.65, 0.7, 0.26, 8),
                    pixarMat(0xfde68a, 0.5)
                );
                stone.position.set(x, 0.12, 2.2 + (Math.sin(x) * 0.4));
                stone.receiveShadow = true;
                scene.add(stone);
            }

            // Pixar Puffy Trees in Background
            const treePositions = [
                [-24, -4], [-13, -5.5], [-1, -5], [12, -5.5], [24, -4],
                [-22, 5.5], [0, 6.2], [23, 5.5]
            ];
            treePositions.forEach(([tx, tz], idx) => {
                createPixarTree(tx, tz, 0.85 + (idx % 3) * 0.2);
            });

            // Soft Puffy 3D Clouds
            for (let i = 0; i < 7; i++) {
                const cloudGroup = new THREE.Group();
                const cloudMat = pixarMat(0xffffff, 0.85);
                for (let j = 0; j < 3; j++) {
                    const puff = new THREE.Mesh(new THREE.SphereGeometry(1.3 - j * 0.25, 16, 16), cloudMat);
                    puff.position.set(j * 1.1 - 1.1, (j % 2) * 0.3, 0);
                    cloudGroup.add(puff);
                }
                cloudGroup.position.set(-25 + i * 9, 10 + (i % 2) * 2, -10 - (i % 3) * 2);
                scene.add(cloudGroup);
                clouds3D.push(cloudGroup);
            }
        }

        function createPixarTree(x, z, scale = 1) {
            const tree = new THREE.Group();
            const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.32, 0.5, 2.4, 12), pixarMat(0x78350f, 0.6));
            trunk.position.y = 1.2;
            trunk.castShadow = true;
            tree.add(trunk);

            const foliageColors = [0x4d7c0f, 0x65a30d, 0x84cc16];
            foliageColors.forEach((col, i) => {
                const crown = new THREE.Mesh(new THREE.SphereGeometry(1.45 - i * 0.28, 18, 18), pixarMat(col, 0.45));
                crown.position.set((i - 1) * 0.35, 2.6 + i * 0.75, 0);
                crown.castShadow = true;
                tree.add(crown);
            });

            tree.position.set(x, 0, z);
            tree.scale.setScalar(scale);
            scene.add(tree);
        }

