<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Pixar Edition: Misteri Hilangnya Mahkota Kerajaan Majapahit - Kelas 5 SD</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --gold-glow: 0 0 25px rgba(245, 158, 11, 0.5);
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: radial-gradient(circle at 50% 0%, #451a03 0%, #1c0a00 75%);
            color: #451a03;
            overflow-x: hidden;
        }
        h1, h2, h3, h4, .font-game {
            font-family: 'Fredoka', sans-serif;
            letter-spacing: 0.02em;
        }
        /* Pixar-style Glossy 3D Cards */
        .pixar-card {
            background: linear-gradient(180deg, #fffdf9 0%, #fef3c7 100%);
            border: 4px solid #92400e;
            box-shadow: 0 12px 0 #451a03, 0 20px 35px rgba(0,0,0,0.55), inset 0 3px 0 #ffffff;
            position: relative;
        }
        .pixar-dark-card {
            background: linear-gradient(180deg, #3b1704 0%, #1f0b01 100%);
            border: 3px solid #d97706;
            box-shadow: 0 10px 0 #0f0500, var(--gold-glow), inset 0 2px 0 rgba(255,255,255,0.2);
        }
        /* 3D Glossy Toy Buttons */
        .btn-3d {
            transition: all 0.16s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 6px 0 #451a03, 0 10px 18px rgba(0,0,0,0.3), inset 0 2px 0 rgba(255,255,255,0.45);
        }
        .btn-3d:hover:not(:disabled) {
            transform: translateY(-3px) scale(1.01);
            box-shadow: 0 9px 0 #451a03, 0 14px 22px rgba(0,0,0,0.35), inset 0 2px 0 rgba(255,255,255,0.6);
        }
        .btn-3d:active:not(:disabled) {
            transform: translateY(4px);
            box-shadow: 0 2px 0 #451a03;
        }
        .btn-gold {
            background: linear-gradient(180deg, #fde047 0%, #f59e0b 55%, #d97706 100%);
            border: 3px solid #78350f;
            color: #451a03;
        }
        .btn-emerald {
            background: linear-gradient(180deg, #6ee7b7 0%, #10b981 55%, #059669 100%);
            border: 3px solid #064e3b;
            box-shadow: 0 6px 0 #064e3b, inset 0 2px 0 rgba(255,255,255,0.45);
            color: #022c22;
        }
        .btn-emerald:hover:not(:disabled) {
            box-shadow: 0 9px 0 #064e3b, inset 0 2px 0 rgba(255,255,255,0.6);
        }
        .btn-emerald:active:not(:disabled) {
            box-shadow: 0 2px 0 #064e3b;
        }
        /* 3D Canvas Stage Container */
        #pixar-stage-wrapper {
            position: relative;
            width: 100%;
            height: 360px;
            border-radius: 1.5rem;
            overflow: hidden;
            border: 4px solid #fbbf24;
            box-shadow: 0 12px 0 #451a03, 0 20px 40px rgba(0,0,0,0.6);
            background: linear-gradient(180deg, #38bdf8 0%, #fde68a 100%);
            cursor: grab;
        }
        #pixar-stage-wrapper:active {
            cursor: grabbing;
        }
        @media (min-width: 768px) {
            #pixar-stage-wrapper {
                height: 410px;
            }
        }
        #three-canvas {
            width: 100%;
            height: 100%;
            display: block;
        }
        /* Floating Speech Bubble in 3D Stage */
        .pixar-bubble {
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(8px);
            border: 3px solid #b45309;
            box-shadow: 0 8px 20px rgba(0,0,0,0.35);
            animation: float-slow 3.2s ease-in-out infinite;
        }
        @keyframes float-slow {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-6px); }
        }
        @keyframes pulse-ring {
            0% { box-shadow: 0 0 0 0 rgba(251, 191, 36, 0.8); }
            70% { box-shadow: 0 0 0 14px rgba(251, 191, 36, 0); }
            100% { box-shadow: 0 0 0 0 rgba(251, 191, 36, 0); }
        }
        .pos-active-glow {
            animation: pulse-ring 2s infinite;
        }
        #confetti-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 100;
        }
        @media print {
            body { background: #fff !important; color: #000 !important; }
            header, #game-view, .no-print { display: none !important; }
            #teacher-view { display: block !important; }
            .pixar-card { box-shadow: none !important; border: 2px solid #000 !important; background: #fff !important; }
        }
    </style>
</head>
<body class="min-h-screen pb-16 selection:bg-amber-400 selection:text-amber-950">

    <!-- Confetti Overlay -->
    <canvas id="confetti-canvas"></canvas>

    <!-- ==================== TOP HUD NAVIGATION BAR ==================== -->
    <header class="bg-gradient-to-b from-[#3b1704] via-[#271003] to-[#1a0901] text-amber-50 border-b-4 border-amber-500 sticky top-0 z-40 shadow-2xl">
        <div class="max-w-6xl mx-auto px-4 py-2.5 flex flex-wrap justify-between items-center gap-3">
            
            <!-- Brand Title -->
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-yellow-300 via-amber-400 to-amber-600 border-2 border-white flex items-center justify-center text-3xl shadow-lg">
                    👑
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="bg-gradient-to-r from-amber-400 to-orange-500 text-amber-950 text-[10px] font-extrabold px-2.5 py-0.5 rounded-full uppercase tracking-wider shadow">
                            ✨ 3D Pixar Animation Edition
                        </span>
                        <span class="bg-amber-500/20 text-amber-300 border border-amber-400/40 text-[10px] font-bold px-2 py-0.5 rounded-full hidden sm:inline">
                            Kelas 5 SD • Kurikulum Merdeka
                        </span>
                    </div>
                    <h1 class="text-lg md:text-2xl font-bold tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-amber-100 via-yellow-300 to-amber-400 leading-tight">
                        Misteri Hilangnya Mahkota Majapahit
                    </h1>
                </div>
            </div>

            <!-- HUD Stats, Audio & Mode Switcher -->
            <div class="flex flex-wrap items-center gap-2 md:gap-2.5">
                
                <!-- Lives & Score Pill -->
                <div id="hud-stats" class="flex items-center gap-3 bg-black/50 px-3.5 py-1.5 rounded-2xl border-2 border-amber-600/80 shadow-inner">
                    <div class="flex items-center gap-1" title="Energi Detektif">
                        <span class="text-xs font-bold text-amber-300 uppercase mr-1 hidden sm:inline">Energi:</span>
                        <span id="lives-display" class="text-base md:text-lg tracking-widest">❤️❤️❤️</span>
                    </div>
                    <div class="h-5 w-0.5 bg-amber-700"></div>
                    <div class="flex items-center gap-1 font-game font-bold text-amber-300">
                        <span class="text-lg">⭐</span>
                        <span id="score-display" class="text-lg md:text-xl text-yellow-300">0</span>
                        <span class="text-xs text-amber-400">XP</span>
                    </div>
                </div>

                <!-- Sound Toggle Button -->
                <button onclick="toggleSound()" id="sound-btn" title="Aktifkan/Matikan Efek Suara Game" class="bg-amber-900 hover:bg-amber-800 text-amber-200 p-2 rounded-2xl border-2 border-amber-500 btn-3d text-base">
                    🔊
                </button>

                <!-- Teacher Guide Mode Button -->
                <button onclick="toggleMode()" id="mode-btn" class="btn-emerald font-game font-bold px-3.5 py-2 rounded-2xl text-xs sm:text-sm btn-3d flex items-center gap-1.5">
                    <span id="mode-icon">📋</span>
                    <span id="mode-btn-text">Panduan & Kunci Guru</span>
                </button>
            </div>
        </div>
    </header>

    <!-- ==================== MAIN CONTAINER ==================== -->
    <main class="max-w-6xl mx-auto px-4 mt-5">

        <!-- ==================== MODE 1: 3D PIXAR INTERACTIVE GAME VIEW ==================== -->
        <div id="game-view" class="space-y-5">

            <!-- ==================== 3D PIXAR ANIMATED WORLD STAGE ==================== -->
            <div id="pixar-stage-wrapper">
                <!-- Three.js WebGL Canvas -->
                <canvas id="three-canvas"></canvas>

                <!-- Top-Left Overlay: Current 3D Scene Location & Camera Controls -->
                <div class="absolute top-3 left-3 right-3 flex flex-wrap justify-between items-start gap-2 pointer-events-none">
                    <div class="bg-black/65 backdrop-blur-md text-amber-50 px-3.5 py-2 rounded-2xl border-2 border-amber-400/80 shadow-lg pointer-events-auto flex items-center gap-2.5">
                        <span id="stage-pos-badge" class="bg-amber-400 text-amber-950 font-game font-bold text-xs px-2.5 py-1 rounded-xl shadow">
                            POS 1 / 4
                        </span>
                        <div>
                            <div id="stage-location-title" class="font-game font-bold text-sm sm:text-base text-yellow-300 leading-none">
                                Bangsal Pusaka Keraton
                            </div>
                            <div class="text-[11px] text-amber-200 mt-0.5">
                                🖱️ Geser layar untuk memutar kamera 3D • Scroll untuk Zoom
                            </div>
                        </div>
                    </div>

                    <!-- Camera Quick Controls & Time of Day -->
                    <div class="flex flex-wrap items-center gap-1.5 pointer-events-auto">
                        <button onclick="triggerCharacterAction()" class="bg-amber-400 hover:bg-amber-300 text-amber-950 font-game font-bold text-xs px-3 py-2 rounded-xl border-2 border-amber-900 shadow-lg transition flex items-center gap-1">
                            <span>🤸</span> <span>Aksi Karakter 3D</span>
                        </button>
                        <button onclick="toggleCharacterCloseup()" id="closeup-btn" class="bg-rose-600 hover:bg-rose-500 text-white font-game font-bold text-xs px-3 py-2 rounded-xl border-2 border-rose-950 shadow-lg transition flex items-center gap-1">
                            <span>🔍</span> <span id="closeup-text">Zoom Karakter</span>
                        </button>
                        <button onclick="toggleDayNight()" id="lighting-btn" class="bg-indigo-950/90 hover:bg-indigo-900 text-amber-200 font-game font-bold text-xs px-3 py-2 rounded-xl border-2 border-amber-400/70 shadow-lg transition">
                            🌅 Sore / 🌙 Malam
                        </button>
                        <button onclick="resetCameraView()" title="Reset Sudut Kamera" class="bg-black/70 hover:bg-black text-amber-200 font-bold text-xs px-2.5 py-2 rounded-xl border border-amber-400/60 shadow-lg">
                            🎥 Reset
                        </button>
                    </div>
                </div>

                <!-- Bottom Floating Pixar Character Dialogue Bubble -->
                <div class="absolute bottom-3 left-3 right-3 flex flex-col sm:flex-row justify-between items-end sm:items-center gap-2 pointer-events-none">
                    <div class="pixar-bubble px-4 py-2.5 rounded-2xl max-w-xl pointer-events-auto flex items-center gap-3">
                        <div id="scene-avatar" class="w-11 h-11 rounded-xl bg-gradient-to-br from-amber-300 to-amber-500 border-2 border-amber-900 flex items-center justify-center text-2xl shrink-0 shadow">
                            🛡️
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span id="speaker-name" class="text-xs font-extrabold uppercase tracking-wider text-amber-900">
                                    Senopati Gajah Mada (3D)
                                </span>
                                <span id="pos-skill" class="text-[10px] font-extrabold bg-amber-900 text-amber-100 px-2 py-0.5 rounded-full">
                                    🎯 Ide Pokok
                                </span>
                            </div>
                            <p id="pos-character-quote" class="text-xs sm:text-sm font-bold text-amber-950 leading-snug mt-0.5">
                                "Perhatikan kotak mahkota yang terbuka dan kain sutra ungu di jendela Bangsal Pusaka itu!"
                            </p>
                        </div>
                    </div>

                    <!-- Pos Quick Switcher Pills inside 3D Viewport -->
                    <div class="flex items-center gap-1.5 bg-black/65 backdrop-blur-md p-1.5 rounded-2xl border-2 border-amber-500/70 pointer-events-auto">
                        <button onclick="jumpToPos(0)" id="cam-pos-0" class="px-2.5 py-1 rounded-xl font-game font-bold text-xs transition">Pos 1</button>
                        <button onclick="jumpToPos(1)" id="cam-pos-1" class="px-2.5 py-1 rounded-xl font-game font-bold text-xs transition">Pos 2</button>
                        <button onclick="jumpToPos(2)" id="cam-pos-2" class="px-2.5 py-1 rounded-xl font-game font-bold text-xs transition">Pos 3</button>
                        <button onclick="jumpToPos(3)" id="cam-pos-3" class="px-2.5 py-1 rounded-xl font-game font-bold text-xs transition">Pos 4</button>
                    </div>
                </div>
            </div>

            <!-- ==================== MAP TRACKER + INVENTORY + GROUP SCORE ==================== -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                
                <!-- Left (2 cols): Interactive 4-Pos Expedition Progress -->
                <div class="lg:col-span-2 pixar-card rounded-3xl p-4 sm:p-5 flex flex-col justify-between">
                    <div class="flex flex-wrap justify-between items-center gap-2 mb-2">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-extrabold uppercase tracking-wider bg-amber-900 text-amber-100 px-3 py-1 rounded-full border border-amber-600 shadow">
                                🗺️ Peta 3D Ekspedisi Trowulan
                            </span>
                            <span class="text-xs font-bold text-amber-800 hidden sm:inline">
                                Klik Pos untuk menerbangkan kamera 3D
                            </span>
                        </div>

                        <!-- Timer Diskusi Kelompok 02:00 -->
                        <button onclick="toggleTimer()" id="timer-btn" class="text-xs bg-gradient-to-r from-amber-800 to-amber-950 hover:from-amber-700 hover:to-amber-900 text-amber-100 px-3.5 py-1.5 rounded-xl font-bold flex items-center gap-1.5 border border-amber-500 shadow transition">
                            <span>⏱️</span>
                            <span id="timer-display">Timer Diskusi (02:00)</span>
                        </button>
                    </div>

                    <!-- Map Nodes & Path -->
                    <div class="relative flex justify-between items-center px-3 sm:px-8 py-3 my-auto">
                        <div class="absolute left-10 right-10 top-1/2 -translate-y-1/2 h-3.5 bg-amber-950/20 border-2 border-amber-900/40 rounded-full z-0"></div>
                        <div id="progress-bar" class="absolute left-10 top-1/2 -translate-y-1/2 h-3.5 bg-gradient-to-r from-emerald-500 to-teal-400 border-y-2 border-l-2 border-emerald-950 rounded-full z-0 transition-all duration-500" style="width: 0%;"></div>

                        <!-- Node 1 -->
                        <button onclick="jumpToPos(0)" id="node-0" class="relative z-10 flex flex-col items-center group focus:outline-none">
                            <div class="node-box w-12 h-12 sm:w-14 sm:h-14 rounded-2xl flex items-center justify-center text-xl sm:text-2xl transition-all duration-300">🏯</div>
                            <span class="node-label mt-1 text-xs font-game font-bold px-2 py-0.5 rounded-lg shadow">Pos 1</span>
                            <span class="text-[10px] font-bold text-amber-900 hidden sm:block">Bangsal Pusaka</span>
                        </button>

                        <!-- Node 2 -->
                        <button onclick="jumpToPos(1)" id="node-1" class="relative z-10 flex flex-col items-center group focus:outline-none">
                            <div class="node-box w-12 h-12 sm:w-14 sm:h-14 rounded-2xl flex items-center justify-center text-xl sm:text-2xl transition-all duration-300">🏺</div>
                            <span class="node-label mt-1 text-xs font-game font-bold px-2 py-0.5 rounded-lg shadow">Pos 2</span>
                            <span class="text-[10px] font-bold text-amber-900 hidden sm:block">Pasar Bubat</span>
                        </button>

                        <!-- Node 3 -->
                        <button onclick="jumpToPos(2)" id="node-2" class="relative z-10 flex flex-col items-center group focus:outline-none">
                            <div class="node-box w-12 h-12 sm:w-14 sm:h-14 rounded-2xl flex items-center justify-center text-xl sm:text-2xl transition-all duration-300">⚖️</div>
                            <span class="node-label mt-1 text-xs font-game font-bold px-2 py-0.5 rounded-lg shadow">Pos 3</span>
                            <span class="text-[10px] font-bold text-amber-900 hidden sm:block">Pendopo Agung</span>
                        </button>

                        <!-- Node 4 -->
                        <button onclick="jumpToPos(3)" id="node-3" class="relative z-10 flex flex-col items-center group focus:outline-none">
                            <div class="node-box w-12 h-12 sm:w-14 sm:h-14 rounded-2xl flex items-center justify-center text-xl sm:text-2xl transition-all duration-300">👑</div>
                            <span class="node-label mt-1 text-xs font-game font-bold px-2 py-0.5 rounded-lg shadow">Pos 4</span>
                            <span class="text-[10px] font-bold text-amber-900 hidden sm:block">Singgasana Raja</span>
                        </button>
                    </div>
                </div>

                <!-- Right (1 col): Tas Barang Bukti 3D & Skor Kelompok -->
                <div class="pixar-dark-card text-amber-50 rounded-3xl p-4 sm:p-5 flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-center mb-2.5">
                            <span class="text-xs font-extrabold uppercase tracking-wider text-amber-300 flex items-center gap-1.5">
                                🎒 Tas Bukti Detektif 3D
                            </span>
                            <span id="clue-counter" class="text-xs bg-amber-500/20 border border-amber-400/50 text-amber-200 px-2 py-0.5 rounded-full font-bold">
                                0/4 Bukti
                            </span>
                        </div>

                        <div class="grid grid-cols-4 gap-2 mb-3">
                            <div id="artifact-0" class="bg-amber-950/80 border-2 border-amber-700/60 rounded-2xl p-2 flex flex-col items-center justify-center text-center opacity-40 transition-all">
                                <span class="text-xl">🧣</span>
                                <span class="text-[10px] font-bold text-amber-200 mt-0.5 leading-tight">Kain Ungu</span>
                            </div>
                            <div id="artifact-1" class="bg-amber-950/80 border-2 border-amber-700/60 rounded-2xl p-2 flex flex-col items-center justify-center text-center opacity-40 transition-all">
                                <span class="text-xl">👣</span>
                                <span class="text-[10px] font-bold text-amber-200 mt-0.5 leading-tight">Jejak Lumpur</span>
                            </div>
                            <div id="artifact-2" class="bg-amber-950/80 border-2 border-amber-700/60 rounded-2xl p-2 flex flex-col items-center justify-center text-center opacity-40 transition-all">
                                <span class="text-xl">🧺</span>
                                <span class="text-[10px] font-bold text-amber-200 mt-0.5 leading-tight">Keranjang</span>
                            </div>
                            <div id="artifact-3" class="bg-amber-950/80 border-2 border-amber-700/60 rounded-2xl p-2 flex flex-col items-center justify-center text-center opacity-40 transition-all">
                                <span class="text-xl">👑</span>
                                <span class="text-[10px] font-bold text-amber-200 mt-0.5 leading-tight">Mahkota</span>
                            </div>
                        </div>
                    </div>

                    <!-- Papan Skor Kelompok Proyektor -->
                    <div class="border-t border-amber-800/80 pt-2.5">
                        <div class="flex justify-between items-center mb-1.5">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-amber-300">
                                🏆 Skor Kelompok (Klik +100)
                            </span>
                            <button onclick="resetTeams()" class="text-[10px] text-amber-400 hover:underline">Reset</button>
                        </div>
                        <div class="grid grid-cols-4 gap-1.5 text-center">
                            <button onclick="addTeamScore(0)" class="bg-amber-900/70 hover:bg-amber-800 border border-amber-600 rounded-xl py-1 px-1 transition">
                                <div class="text-[10px] text-amber-200 font-bold">Tim 1</div>
                                <div id="team-score-0" class="text-sm font-game font-bold text-yellow-300">0</div>
                            </button>
                            <button onclick="addTeamScore(1)" class="bg-amber-900/70 hover:bg-amber-800 border border-amber-600 rounded-xl py-1 px-1 transition">
                                <div class="text-[10px] text-amber-200 font-bold">Tim 2</div>
                                <div id="team-score-1" class="text-sm font-game font-bold text-yellow-300">0</div>
                            </button>
                            <button onclick="addTeamScore(2)" class="bg-amber-900/70 hover:bg-amber-800 border border-amber-600 rounded-xl py-1 px-1 transition">
                                <div class="text-[10px] text-amber-200 font-bold">Tim 3</div>
                                <div id="team-score-2" class="text-sm font-game font-bold text-yellow-300">0</div>
                            </button>
                            <button onclick="addTeamScore(3)" class="bg-amber-900/70 hover:bg-amber-800 border border-amber-600 rounded-xl py-1 px-1 transition">
                                <div class="text-[10px] text-amber-200 font-bold">Tim 4</div>
                                <div id="team-score-3" class="text-sm font-game font-bold text-yellow-300">0</div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== MAIN MISSION READING & QUIZ CARD ==================== -->
            <div id="mission-card" class="pixar-card rounded-3xl overflow-hidden">
                
                <!-- Card Header Bar -->
                <div class="bg-gradient-to-r from-amber-900 via-amber-800 to-amber-950 px-6 py-4 text-amber-50 border-b-4 border-amber-950 flex flex-wrap justify-between items-center gap-3">
                    <div>
                        <div class="flex items-center gap-2">
                            <span id="pos-badge" class="bg-amber-400 text-amber-950 font-game font-bold px-3 py-0.5 rounded-lg text-xs shadow">
                                POS MISI 1 DARI 4
                            </span>
                            <span id="location-tag" class="text-xs font-bold text-amber-200 bg-black/30 px-2.5 py-0.5 rounded-lg border border-amber-500/40">
                                📍 Lokasi 3D: Bangsal Pusaka Keraton
                            </span>
                        </div>
                        <h2 id="pos-title" class="text-xl sm:text-2xl font-bold text-white mt-1">
                            Geger di Bangsal Pusaka
                        </h2>
                    </div>

                    <!-- Accessibility Tools: Read Aloud & Font Scaler -->
                    <div class="flex items-center gap-2 bg-black/35 p-1.5 rounded-2xl border border-amber-500/40">
                        <button onclick="speakNarrative()" id="tts-btn" class="bg-amber-400 hover:bg-amber-300 text-amber-950 font-game font-bold px-3 py-1.5 rounded-xl text-xs sm:text-sm flex items-center gap-1.5 shadow transition">
                            <span id="tts-icon">🔊</span> <span id="tts-text">Bacakan Cerita</span>
                        </button>
                        <button onclick="changeFontSize(1)" title="Perbesar Teks untuk Proyektor" class="bg-amber-900/80 hover:bg-amber-800 text-amber-100 font-bold px-2.5 py-1.5 rounded-xl text-xs border border-amber-600">
                            A+
                        </button>
                        <button onclick="changeFontSize(-1)" title="Perkecil Teks" class="bg-amber-900/80 hover:bg-amber-800 text-amber-100 font-bold px-2.5 py-1.5 rounded-xl text-xs border border-amber-600">
                            A-
                        </button>
                    </div>
                </div>

                <!-- Mission Content Body -->
                <div class="p-5 sm:p-7">

                    <!-- 1. Narasi Cerita (1 Paragraf Penuh) -->
