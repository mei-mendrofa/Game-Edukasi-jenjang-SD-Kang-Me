        function speakNarrative() {
            if (!('speechSynthesis' in window)) return;
            const synth = window.speechSynthesis;
            if (synth.speaking) {
                synth.cancel();
                document.getElementById('tts-icon').innerText = '🔊';
                document.getElementById('tts-text').innerText = 'Bacakan Cerita';
                return;
            }
            const m = missions[currentPos];
            const utter = new SpeechSynthesisUtterance(m.plainNarrative);
            utter.lang = 'id-ID';
            utter.rate = 0.95;
            utter.onstart = () => {
                document.getElementById('tts-icon').innerText = '⏹️';
                document.getElementById('tts-text').innerText = 'Hentikan Suara';
            };
            utter.onend = () => {
                document.getElementById('tts-icon').innerText = '🔊';
                document.getElementById('tts-text').innerText = 'Bacakan Cerita';
            };
            synth.speak(utter);
        }

