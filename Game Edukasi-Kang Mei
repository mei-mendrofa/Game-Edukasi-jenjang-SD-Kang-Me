        // ==================== 3D INTERACTION & ANIMATION LOOP ====================
        function setupStageInteractions(container) {
            let downTime = 0;
            container.addEventListener('mousedown', e => {
                isDragging3D = true;
                downTime = Date.now();
                prevPointer = { x: e.clientX, y: e.clientY };
            });
            window.addEventListener('mouseup', e => {
                if (isDragging3D && Date.now() - downTime < 220) {
                    handleStageClick(e, container);
                }
                isDragging3D = false;
            });
            window.addEventListener('mousemove', e => {
                if (!isDragging3D) return;
                const dx = e.clientX - prevPointer.x;
                const dy = e.clientY - prevPointer.y;
                userOrbitAngleX = Math.max(-1.2, Math.min(1.2, userOrbitAngleX - dx * 0.006));
                userOrbitAngleY = Math.max(-0.4, Math.min(0.6, userOrbitAngleY + dy * 0.005));
                prevPointer = { x: e.clientX, y: e.clientY };
            });

            // Touch Support for Mobile/Interactive Flat Panels
            container.addEventListener('touchstart', e => {
                if (e.touches.length === 1) {
                    isDragging3D = true;
                    prevPointer = { x: e.touches[0].clientX, y: e.touches[0].clientY };
                }
            }, { passive: true });
            window.addEventListener('touchend', () => { isDragging3D = false; });
            window.addEventListener('touchmove', e => {
                if (!isDragging3D || e.touches.length !== 1) return;
                const dx = e.touches[0].clientX - prevPointer.x;
                const dy = e.touches[0].clientY - prevPointer.y;
                userOrbitAngleX = Math.max(-1.2, Math.min(1.2, userOrbitAngleX - dx * 0.006));
                userOrbitAngleY = Math.max(-0.4, Math.min(0.6, userOrbitAngleY + dy * 0.005));
                prevPointer = { x: e.touches[0].clientX, y: e.touches[0].clientY };
            }, { passive: true });

            // Mouse Wheel Zoom
            container.addEventListener('wheel', e => {
                e.preventDefault();
                userZoomOffset = Math.max(-5.5, Math.min(6, userZoomOffset + e.deltaY * 0.005));
            }, { passive: false });
        }

        // Click directly on any 3D Pixar Character to make them perform a Heroic Spin & Wave!
        function handleStageClick(e, container) {
            const rect = container.getBoundingClientRect();
            mouseVec.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
            mouseVec.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
            raycaster.setFromCamera(mouseVec, camera);

            const meshes = [];
            characters3D.forEach(c => {
                c.group.traverse(child => {
                    if (child.isMesh) meshes.push(child);
                });
            });

            const hits = raycaster.intersectObjects(meshes, false);
            if (hits.length > 0) {
                sfxSuccess();
                jumpCelebrationTimer = 70;
                characters3D.forEach(c => { c.spinTimer = 45; });
            }
        }

